{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/run-v2-recovery.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/recovery.cjs && npm run build:camera",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test:unit": "node scripts/run-ts-tests.mjs",
    "test:image-export": "node scripts/run-ts-tests.mjs src/lib/imageCapture.test.ts src/components/DocumentPreview.test.ts",
    "test:image-assets": "node scripts/run-ts-tests.mjs server/image-assets src/lib/imageAssets.test.ts src/lib/companyImageState.test.ts src/lib/db.test.ts src/lib/productImages.test.ts",
    "test:image-assets:smoke": "node scripts/smoke-image-assets.mjs",
    "test:all": "npm run lint && npm run test:unit && npm run build && npm run structure:check && node scripts/smoke-v2-entry.mjs",
    "migrate:image-assets": "tsx scripts/migrate-image-assets.ts",
    "migrate:product-image-roles": "tsx scripts/migrate-product-image-roles.ts",
    "test:security": "node scripts/smoke-security.mjs",
    "build:camera": "vite build --config vite.camera.config.ts",
    "structure:check": "node scripts/check-project-structure.mjs",
    "v2:source": "node scripts/check-fabric-v2-development-source.mjs",
    "knowledge:check": "node scripts/fabric-knowledge-graph.mjs audit && node scripts/check-fabric-v2-doc-navigation.mjs && node --test scripts/fabric-knowledge-graph.test.mjs",
    "knowledge:map": "node scripts/fabric-knowledge-graph.mjs map",
    "knowledge:impact": "node scripts/fabric-knowledge-graph.mjs impact",
    "knowledge:changed": "node scripts/fabric-knowledge-graph.mjs changed",
    "release": "node scripts/fabric-release.mjs",
    "test:release": "node scripts/fabric-release.mjs test",
    "test:ui:ux": "playwright test --config=playwright.ui.config.ts",
    "ui:preflight": "node scripts/ui-workflow-gate.mjs preflight",
    "ui:template": "node scripts/ui-workflow-gate.mjs template",
    "ui:verify": "node scripts/ui-workflow-gate.mjs verify",
    "ui:seal": "node scripts/ui-workflow-gate.mjs seal",
    "workspace:init": "node scripts/init-fabric-workspace.mjs",
    "test:ui:workflow": "node --test scripts/ui-workflow-gate.test.mjs",
    "workspace:status": "node scripts/fabric-workspace.mjs status",
    "workspace:clean": "node scripts/fabric-workspace.mjs clean",
    "workspace:commit": "node scripts/fabric-workspace.mjs commit",
    "parallel": "node scripts/fabric-parallel-git.mjs",
    "test:parallel": "node --test scripts/fabric-parallel-git.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fflate": "^0.8.2",
    "geotiff": "^3.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.2.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "qrcode": "1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.3",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "@radix-ui/react-dialog": "^1.3.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "react-test-renderer": "19.2.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@playwright/test": "^1.64.1"
  }
}
