{
  "name": "fabric-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fabric-v2-workspace.mjs dev",
    "build": "node scripts/fabric-v2-workspace.mjs build",
    "start": "node scripts/fabric-v2-workspace.mjs start",
    "clean": "node scripts/fabric-v2-workspace.mjs clean",
    "lint": "node scripts/fabric-v2-workspace.mjs lint",
    "test:unit": "node scripts/fabric-v2-workspace.mjs test:unit",
    "test:image-export": "node scripts/fabric-v2-workspace.mjs test:image-export",
    "test:image-assets": "node scripts/fabric-v2-workspace.mjs test:image-assets",
    "test:image-assets:smoke": "node scripts/fabric-v2-workspace.mjs test:image-assets:smoke",
    "test:all": "npm run lint && npm run test:unit && npm run build && npm run test:security && npm run test:image-assets:smoke",
    "migrate:image-assets": "node scripts/fabric-v2-workspace.mjs migrate:image-assets",
    "migrate:product-image-roles": "node scripts/fabric-v2-workspace.mjs migrate:product-image-roles",
    "test:security": "node scripts/fabric-v2-workspace.mjs test:security",
    "build:camera": "node scripts/fabric-v2-workspace.mjs build:camera",
    "v2:source": "node scripts/fabric-v2-workspace.mjs check",
    "workspace:status": "node scripts/fabric-workspace.mjs status",
    "workspace:clean": "node scripts/fabric-workspace.mjs clean",
    "workspace:commit": "node scripts/fabric-workspace.mjs commit",
    "release": "node scripts/fabric-release.mjs",
    "test:release": "node scripts/fabric-release.mjs test",
    "test:ui:ux": "node scripts/fabric-v2-workspace.mjs test:ui:ux",
    "ui:preflight": "node scripts/ui-workflow-gate.mjs preflight",
    "ui:template": "node scripts/ui-workflow-gate.mjs template",
    "ui:verify": "node scripts/ui-workflow-gate.mjs verify",
    "test:ui:workflow": "node --test scripts/ui-workflow-gate.test.mjs",
    "workspace:init": "node scripts/fabric-v2-workspace.mjs init",
    "test:workspace": "node --test scripts/fabric-workspace.test.mjs scripts/workspace-followups.test.mjs",
    "parallel": "node scripts/fabric-parallel-git.mjs",
    "test:parallel": "node --test scripts/fabric-parallel-git.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
