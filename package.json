    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "fflate": "^0.8.2",
