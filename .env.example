# Server
# ADMIN_PASSWORD is required; the server refuses to start without it.
ADMIN_PASSWORD="replace_with_a_long_random_password"
HOST="127.0.0.1"
PORT="3000"

# Rate limiting. Defaults: 15 minutes, 1000 API requests, 10 failed logins per client IP.
RATE_LIMIT_WINDOW_MS="900000"
API_RATE_LIMIT_MAX="1000"
LOGIN_RATE_LIMIT_MAX="10"

# MySQL (omit all four keys to use the local JSON development fallback)
DB_HOST="localhost"
DB_USER="fabric_user"
DB_PASSWORD="replace_with_database_password"
DB_DATABASE="fabric_db"

# Unified private image assets. Keep all feature flags false until rollout checks pass.
IMAGE_ASSETS_ENABLED="false"
COMPANY_IMAGE_ASSETS_ENABLED="false"
PRODUCT_IMAGE_ASSETS_ENABLED="false"
ASSET_STORAGE_PROVIDER="cos"
ASSET_SIGNED_URL_TTL_SECONDS="300"
ASSET_UPLOAD_GRANT_TTL_SECONDS="900"
ASSET_UPLOAD_SESSION_TTL_SECONDS="86400"
ASSET_RECYCLE_DAYS="30"

# Tencent Cloud COS (required when image assets are enabled with ASSET_STORAGE_PROVIDER="cos")
# Legacy upload paths still use local storage when this legacy COS configuration is omitted.
COS_SECRET_ID="replace_with_cos_secret_id"
COS_SECRET_KEY="replace_with_cos_secret_key"
COS_REGION="ap-shanghai"
COS_BUCKET="replace_with_cos_bucket"

# Legacy image migration (scripts/migrate-image-assets.ts). Dry-run is the
# default and performs no writes; --apply is required to write.
#   npm.cmd run migrate:image-assets -- --domain=company --dry-run --report=reports/migration-company.json
#   npm.cmd run migrate:image-assets -- --apply --domain=product --batch-size=100 --after-id=0 --report=reports/migration-product.json
# Flags: --dry-run | --apply, --domain=company|product|all, --batch-size=N,
# --after-id=N, --report=<path inside the project directory>.
# Migration reads legacy company image fields and product_images rows through
# the controlled legacy reader, validates and hashes bytes, deduplicates by
# sha256, and attaches assets via the same association semantics as the server.

# Bulk product image upload (scripts/upload-product-images.mjs) uses the
# authenticated asset API; no COS SDK, Sharp, or direct product_images writes.
# PRODUCT_IMAGE_DIR="D:/jpg"                    # directory to scan for images
# PRODUCT_IMAGE_API_BASE_URL="http://127.0.0.1:3000"  # override server base URL
